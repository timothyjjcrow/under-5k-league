# Copy to .env and fill in.
DATABASE_URL="file:./dev.db"
# Production uses a pooled PostgreSQL DATABASE_URL and a direct DIRECT_URL.
DIRECT_URL=""
# Generate a real secret with `openssl rand -hex 32`. Never copy a documented
# placeholder into production; the production build rejects one.
AUTH_SECRET=""
# Separate HMAC key for portable full-backup verification receipts. Production
# requires a unique random value of at least 32 characters. Keep the same value
# in Vercel and the private environment used to verify production backups.
BACKUP_RECEIPT_SECRET=""
STEAM_API_KEY=""
# Local development only. Production requires this to be unset or exactly false.
ALLOW_DEV_LOGIN="true"
APP_URL="http://localhost:3000"
# Comma-separated SteamID64s. When set, this is AUTHORITATIVE: exactly these
# accounts are admins (everyone else is demoted on login). Production requires
# at least one valid, unique id; first-user bootstrap is development-only setup.
ADMIN_STEAM_IDS=""
OPENDOTA_API_KEY=""
# Canonical public site origin for social-preview (OG/Twitter) images. On Vercel
# this is auto-detected from the deployment; set it only to pin a custom domain,
# e.g. "https://under5k.gg". Must include the scheme and no trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Under 4.5K League"
# Emergency production-only acknowledgement. Leave unset normally. A schema
# change that Prisma identifies as destructive fails the deploy unless this is
# set to the exact phrase plus the current 40-character VERCEL_GIT_COMMIT_SHA.
# PRISMA_ACCEPT_DATA_LOSS="I_UNDERSTAND_THIS_MAY_DELETE_PRODUCTION_DATA:<commit-sha>"
# Discord incoming-webhook URL for league announcements (signups, draft,
# results, playoffs, champion). Admins can also set/override it at runtime in
# the admin panel; leave empty to disable.
DISCORD_WEBHOOK_URL=""
# Discord OAuth app for account linking ("Link Discord" on /me — proves a
# player owns their Discord account; only the `identify` scope is requested).
# Create at https://discord.com/developers/applications → OAuth2, add
# <APP_URL>/api/auth/discord/callback as a Redirect, then copy the client id
# + secret. Leave empty to hide the Link button (typed handles still work).
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
