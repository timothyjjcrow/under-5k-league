# Copy to .env and fill in.
DATABASE_URL="file:./dev.db"
# Production uses a pooled PostgreSQL DATABASE_URL for the app and a direct
# DIRECT_URL for backups and reviewed migrations. Recognized provider
# pool/direct hosts, ports, and passwords may differ, but this release requires
# the same username and logical database/schema in both URLs. Custom providers
# without a reviewed normalization rule must use the same hostname and
# effective port.
# Scope both credentials to Production; Preview needs its own database branch.
# Never define PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK. Production migrations must
# retain Prisma's advisory lock, and the production environment gate rejects it.
DIRECT_URL=""
# Generate a real secret with `openssl rand -hex 32`. Never copy a documented
# placeholder into production; the production build rejects one.
AUTH_SECRET=""
# Dedicated bearer used only by the unattended maintenance scheduler. The
# Cloudflare Worker stores the same value as its encrypted AUTOMATION_SECRET
# and sends it as `Authorization: Bearer …`. Production requires a unique
# random value of at least 32 and at most 512 characters, with no whitespace.
# Never put it in a URL, repository file, log, or public NEXT_PUBLIC variable.
CRON_SECRET=""
# Separate HMAC key for portable full-backup verification receipts. Production
# requires a unique random value of at least 32 characters. Keep the same value
# in Vercel and the private environment used to verify production backups.
BACKUP_RECEIPT_SECRET=""
# Required in production for Steam profile lookup after OpenID authentication.
# Keep it server-only and verify it with a real allowlisted login before launch.
STEAM_API_KEY=""
# Local development only. Production requires this to be unset or exactly false.
ALLOW_DEV_LOGIN="true"
APP_URL="http://localhost:3000"
# Comma-separated SteamID64s. When set, this is AUTHORITATIVE: exactly these
# accounts are admins (everyone else is demoted on login). Production requires
# at least one valid, unique id; first-user bootstrap is development-only setup.
ADMIN_STEAM_IDS=""
OPENDOTA_API_KEY=""
# Canonical public site origin for social-preview (OG/Twitter) images. On Vercel
# this is auto-detected from the deployment; set it only to pin a custom domain,
# e.g. "https://ggd2l.example". Must include the scheme and no trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Leave unset for the regional default ("GGD2L", or "GGD2L Europe" with
# NEXT_PUBLIC_LEAGUE_REGION=eu). User-facing copy always says GGD2L.
NEXT_PUBLIC_APP_NAME=""
# Discord incoming-webhook URL for league announcements (signups, draft,
# results, playoffs, champion). Admins can also set/override it at runtime in
# the admin panel; leave empty to disable. Only an exact HTTPS Discord webhook
# is accepted: discord.com or discordapp.com, optional /api/v9|v10, then
# /webhooks/<5-25 digit id>/<16-256 URL-safe token>; no port, query, fragment,
# credentials, whitespace, or alternate host.
DISCORD_WEBHOOK_URL=""
# Discord OAuth app for account linking ("Link Discord" on /me — proves a
# player owns their Discord account). The app requests `identify`; when both bot
# variables below are configured it also requests `guilds.join` so linking can
# add the player to the league server.
# Create at https://discord.com/developers/applications → OAuth2, add
# <APP_URL>/api/auth/discord/callback as a Redirect, then copy the client id
# + secret. Set both or neither; leave both empty to hide the Link button (typed
# handles still work).
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# Optional Discord bot integration for guild joining, membership checks, and
# the self-serve inhouse ping role. Set both variables or neither. When OAuth is
# also enabled, use the bot token from the same Discord application as the OAuth
# client. DISCORD_API_BASE is an integration-test seam and must remain unset in
# production.
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""
# Optional environment fallbacks for the inhouse Discord board, rally/match
# alerts, and ping-role mentions. The same exact Discord-webhook rule applies;
# invalid values fail the production environment gate and are never fetched.
# The admin settings UI can override these.
DISCORD_INHOUSE_WEBHOOK_URL=""
DISCORD_INHOUSE_ALERT_WEBHOOK_URL=""
DISCORD_INHOUSE_ROLE_ID=""

# Optional persistent Steam/Dota lobby service. No Steam password goes in the
# web app. HTTPS in production, or exactly http://127.0.0.1:8090 for the bot on
# the same box; local development permits loopback HTTP.
DOTA_LOBBY_BOT_URL=""
# Independent random secret (at least 32 characters), shared only by app + bot.
DOTA_LOBBY_BOT_SECRET=""
# Numeric Valve league ID for the Under 5K In-House League ticket.
DOTA_INHOUSE_LEAGUE_ID=""
# Reserve the bot for in-house games by default. Set exactly true only when
# ready to share it with season games, which use their season's dotaLeagueId.
DOTA_SEASON_LOBBY_BOT_ENABLED="false"

# Self-hosted box only (ops/selfhost). Leave these three unset for local
# development, the test suites and Vercel; unset, the app behaves exactly as it
# does there. On the box they live in /etc/ggd2l/<league>.env, and its env
# contract refuses to start a unit whose values break the rules below.
#
# Deploy marker: exactly "production" (the live league) or "staging" (a
# rehearsal copy). Once declared, only "production" may write to Discord, and
# redirects and the same-origin check use APP_URL instead of the request's own
# address. Any other value, even "", counts as declared and fails closed, so
# keep the line commented out rather than empty.
# LEAGUE_DEPLOY_ENV="production"
# Rate-limit by Cloudflare's client address alone. Set it only where every
# request arrives through Cloudflare (the box's tunnel); anywhere else a client
# can forge the header. Exactly "cf-connecting-ip", or unset.
# CLIENT_IP_HEADER="cf-connecting-ip"
# One fixed key per league, the base64 of 32 random bytes
# (`openssl rand -base64 32`), present at build and at runtime. Next salts
# server-action IDs with it and encrypts action closures with it, so a fixed
# key keeps forms that are open during a release working. Rotating it breaks
# every form open at that moment. Never commit it or share it between leagues.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
