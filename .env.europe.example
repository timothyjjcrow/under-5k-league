# Europe is a separate Vercel project and a fresh, dedicated PostgreSQL database.
# These are placeholders/public defaults, never production credentials.
# Supply private values via Europe project environment variables. See
# docs/EUROPE-SETUP.md for migration/bootstrap ordering and scheduler setup.
NEXT_PUBLIC_LEAGUE_REGION="eu"
NEXT_PUBLIC_APP_NAME="GGD2L Europe"
APP_URL="https://ggd2l-europe.vercel.app"
NEXT_PUBLIC_SITE_URL="https://ggd2l-europe.vercel.app"
NEXT_PUBLIC_LEAGUE_TIMEZONE="Europe/Berlin"
# Keep both empty until match night is announced. Bootstrap creates no date.
NEXT_PUBLIC_MATCH_DAY=""
NEXT_PUBLIC_MATCH_TIME=""
# Leave empty until the Europe Discord is ready; the site hides invite links.
NEXT_PUBLIC_DISCORD_INVITE_URL=""

# Dedicated Europe pooled and direct URLs for the SAME database/schema/user.
# Apply the repository's reviewed migrations; never restore US production data.
DATABASE_URL=""
DIRECT_URL=""
# Generate distinct random values for each, independent of all US secrets.
AUTH_SECRET=""
CRON_SECRET=""
BACKUP_RECEIPT_SECRET=""
STEAM_API_KEY=""
ADMIN_STEAM_IDS=""
ALLOW_DEV_LOGIN="false"
OPENDOTA_API_KEY=""

# Europe Discord application, guild and channels. Set related pairs together.
# OAuth redirect: https://ggd2l-europe.vercel.app/api/auth/discord/callback
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""
DISCORD_WEBHOOK_URL=""
DISCORD_INHOUSE_WEBHOOK_URL=""
DISCORD_INHOUSE_ALERT_WEBHOOK_URL=""
DISCORD_INHOUSE_ROLE_ID=""

# Shared lobby relay and bot secret; one Steam worker hosts one lobby at a time.
# That worker uses DOTA_GAME_SERVER_REGIONS=2,3 and retains its existing state.
# Europe still needs its OWN league ticket; never reuse the US ticket ID.
# A dedicated Europe worker remains an alternative; see docs/EUROPE-SETUP.md.
DOTA_LOBBY_BOT_URL=""
DOTA_LOBBY_BOT_SECRET=""
DOTA_INHOUSE_LEAGUE_ID=""
NEXT_PUBLIC_INHOUSE_LEAGUE_NAME=""
DOTA_SEASON_LOBBY_BOT_ENABLED="false"
