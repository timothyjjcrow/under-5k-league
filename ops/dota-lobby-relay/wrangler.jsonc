{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ggd2l-dota-lobby-relay",
  "main": "src/index.mjs",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "LOBBY_RELAY", "class_name": "LobbyRelay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LobbyRelay"] }],
  "secrets": {
    "required": ["DOTA_LOBBY_BOT_SECRET", "DOTA_RELAY_WORKER_SECRET"]
  }
}
