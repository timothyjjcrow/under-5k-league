# Weekly restore drill (design §5.1, D18): restore the league's newest local
# dump into the scratch database ld2l_restore_test as ggd2l_rehearsal, migrate
# it with the current tools, check it, drop it, ping healthchecks. %i is the
# league. drill.env holds only PG_RESTORE_TEST_URL; the drill never sees a
# league role's password. Every run ends in ggd2l-alert@drill-%i.service, which
# posts to Discord when a drill fails and when the next one passes.
#
# It runs as ggd2l-drill, never ggd2l-ops: it runs a tools clone, which the
# build user's npm ci wrote, and ggd2l-ops holds the R2 key and the backups.
# It reads only the dump the hourly backup hands it
# (/var/backups/ggd2l/%i/drill/, group ggd2l-drill) and writes only its own
# folder.
[Unit]
Description=GGD2L %i backup restore drill
After=network-online.target postgresql@18-main.service
Wants=network-online.target
OnFailure=ggd2l-alert@drill-%i.service
OnSuccess=ggd2l-alert@drill-%i.service

[Service]
Type=oneshot
User=ggd2l-drill
Group=ggd2l-drill
WorkingDirectory=/var/lib/ggd2l-drill/%i
EnvironmentFile=/etc/ggd2l/drill.env
EnvironmentFile=-/etc/ggd2l/healthchecks.env
# Prisma (the drill migrates the restored copy) must not phone home.
Environment=CHECKPOINT_DISABLE=1
ExecStart=/usr/local/lib/ggd2l/drill-league.sh %i
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
MemoryMax=700M
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# The one writable path: drill-league.sh refuses a folder it cannot write
# (its copy of the dump, last-drill.json). ProtectSystem=strict leaves
# everything else read-only, /run and /run/lock included, so the lock both
# leagues' drills share (they share the scratch database) is a read-only
# descriptor of /var/lib/ggd2l-drill (backup-scripts.test.mjs checks both).
ReadWritePaths=/var/lib/ggd2l-drill/%i
