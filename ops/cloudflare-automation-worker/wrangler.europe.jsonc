{
  "name": "ggd2l-europe-automation-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "workers_dev": false,
  "vars": {
    "AUTOMATION_URL": "https://ggd2l-europe.vercel.app/api/cron/automation"
  },
  "triggers": { "crons": ["* * * * *"] },
  "secrets": { "required": ["AUTOMATION_SECRET"] }
}
