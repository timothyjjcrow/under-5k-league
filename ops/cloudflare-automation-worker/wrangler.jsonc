{
  "name": "ggd2l-automation-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "workers_dev": false,
  "vars": {
    "AUTOMATION_PAUSED": "false",
    "AUTOMATION_URL": "https://us.ggd2l.com/api/cron/automation"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "secrets": {
    "required": ["AUTOMATION_SECRET"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ALERT_STATE", "class_name": "SchedulerAlertState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SchedulerAlertState"] }]
}
