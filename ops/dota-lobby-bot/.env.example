# Sign in with `npm run login` (Steam Guard QR) or
# `npm run login -- --password` (private terminal prompts).
# A renewable session is saved in the private state directory; no password needed.
# Optional legacy fallback, only when there is no saved session:
STEAM_BOT_USERNAME=""
STEAM_BOT_PASSWORD=""
# Generate with openssl rand -hex 32; put the same value in the web app.
DOTA_LOBBY_BOT_SECRET=""
# Must match the web app: 2 = US East (default), 3 = Europe West.
DOTA_GAME_SERVER_REGION="2"
# Optional: one shared worker may serve US and EU, one lobby at a time.
# This explicit allowlist overrides DOTA_GAME_SERVER_REGION when set.
# DOTA_GAME_SERVER_REGIONS="2,3"
# Both websites use this same relay; EU request keys must carry the eu: prefix.
# Optional outbound relay (recommended for Mac/cloud hosts with no public port).
# The relay URL is an HTTPS origin; this worker uses WSS /connect internally.
DOTA_LOBBY_RELAY_URL=""
DOTA_RELAY_WORKER_SECRET=""
# Persistent private volume. Never share it across processes/accounts.
DOTA_BOT_STATE_DIR="./state"
# Keep loopback binding behind an HTTPS reverse proxy on your worker host.
HOST="127.0.0.1"
PORT="8090"

# For a second European worker, save a separate .env.eu and use a different
# Steam account, secret, relay URL, DOTA_BOT_STATE_DIR="./state/eu", PORT="8091",
# and DOTA_GAME_SERVER_REGION="3". Never copy an existing Steam session.
# Sign in: node --env-file=.env.eu login.mjs
# Install on Mac: node macos-service.mjs install --instance eu --keep-awake
# Manage it: node macos-service.mjs status|start|stop|uninstall --instance eu
