# Europe worker only. Copy to .env.eu with mode 0600; fill the three empty
# connection settings with Europe's relay origin and independent secrets.
# Sign in to a separate dedicated Steam account using:
# node --env-file=.env.eu login.mjs
DOTA_LOBBY_BOT_SECRET=""
DOTA_RELAY_WORKER_SECRET=""
DOTA_LOBBY_RELAY_URL=""
DOTA_GAME_SERVER_REGION="3"
DOTA_BOT_STATE_DIR="./state/eu"
HOST="127.0.0.1"
PORT="8091"

# Install after relay configuration and Steam sign-in:
# node macos-service.mjs install --instance eu --keep-awake
# node macos-service.mjs status --instance eu
# The helper refuses state-directory or port collisions with other instances.
# Never copy the US Steam session or reuse the US bot's credentials.
